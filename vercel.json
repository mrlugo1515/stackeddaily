{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/api/track",  "dest": "/api/track.js"  },
    { "src": "/api/events", "dest": "/api/events.js" },
    { "src": "/blog",       "dest": "/blog.html"     },
    { "src": "/shop",       "dest": "/store.html"    },
    { "src": "/store",      "dest": "/store.html"    },
    { "src": "/resources",  "dest": "/resources.html" },
    { "src": "/article",    "dest": "/article.html"  },
    { "src": "/thank-you",  "dest": "/thank-you.html" },
    { "src": "/admin",      "dest": "/admin.html"    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",   "value": "nosniff" },
        { "key": "Referrer-Policy",          "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cache-Control",   "value": "no-store" }
      ]
    }
  ]
}
