{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/blog", "dest": "/blog.html" },
    { "src": "/shop", "dest": "/store.html" },
    { "src": "/store", "dest": "/store.html" },
    { "src": "/resources", "dest": "/resources.html" },
    { "src": "/article", "dest": "/article.html" },
    { "src": "/thank-you", "dest": "/thank-you.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
